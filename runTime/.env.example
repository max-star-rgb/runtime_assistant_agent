# Copy this file to .env and fill real values.
# WARNING: Do not commit .env (it is gitignored).

# 指定模型提供商（必填）：anthropic / minimax / qwen
LLM_PROVIDER=minimax

# 然后只需填对应提供商的配置：

# --- 若 LLM_PROVIDER=anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT_S=120

# --- 若 LLM_PROVIDER=minimax ---
# MINIMAX_API_KEY=your_minimax_key_here
# MINIMAX_MODEL=MiniMax-M2.7
# MINIMAX_REGION=CN
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# MINIMAX_MAX_TOKENS=1024
# MINIMAX_TIMEOUT_S=120

# --- 若 LLM_PROVIDER=qwen ---
# QWEN_API_KEY=your_qwen_key_here
# QWEN_MODEL=qwen3-coder-plus
# QWEN_REGION=CN
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
# QWEN_MAX_TOKENS=8192
# QWEN_TIMEOUT_S=120

# Skills prompt budget (OpenClaw-like)
SKILLS_MAX_PROMPT_CHARS=30000
SKILLS_MAX_IN_PROMPT=150

# Gateway: set to 1 to forward event.skill and event.tool frames to WebSocket clients (debugging)
# GATEWAY_FORWARD_EVENT_TOOL=0

# Allow read_file / list_dir / grep / exec cwd outside the repo (pipe | separated absolute paths).
# Example Windows: EXTRA_WORKSPACE_DIRS=C:\\Users\\YourName\\Desktop
# EXTRA_WORKSPACE_DIRS=

# 云端比价服务（POST JSON）；设置后 Agent 可使用 price_compare 工具
# PRICE_COMPARE_SERVICE_URL=https://your-api.example.com/v1/compare
# PRICE_COMPARE_API_KEY=
# PRICE_COMPARE_TIMEOUT_S=45

# web_search（DuckDuckGo，默认启用，无需 API Key）
# WEB_SEARCH_TIMEOUT_S=20
# WEB_SEARCH_CACHE_TTL=300

# Agentic tool loop: max rounds of tool_use → tool_result before forcing stop (default 25)
# MAX_TOOL_ROUNDS=25

# 可选：Serper 批量 Google 搜索（工具 batch_web_search，需付费 key）
# SERPER_API_KEY=
# SERPER_MAX_QUERIES=5
# SERPER_TIMEOUT_S=20

# --- 浏览器工具 (browser) ---
# 优先使用 Patchright (反检测Playwright)，自动回退到 Playwright
# BROWSER_HEADLESS=true              # true=无头(默认), false=有头(推荐，反检测更好)
# BROWSER_TIMEOUT_S=30               # 页面加载/操作超时(秒)
# BROWSER_USER_DATA_DIR=             # 持久化浏览器数据目录(cookie/session自动保存，默认系统临时目录)

# --- 淘宝 Cookie 文件 (taobao-cart 技能) ---
# 从浏览器导出的淘宝cookie JSON文件路径，配置后加购时无需每次手动指定
# TAOBAO_COOKIE_FILE=D:\cookies\taobao.json

# --- 记忆服务 ---
# 外部记忆服务地址（REST API），不设则使用本地 JSON 文件存储
# MEMORY_SERVICE_URL=http://localhost:9000
# 本地记忆存储目录（仅当未设置 MEMORY_SERVICE_URL 时生效，默认系统临时目录）
# MEMORY_LOCAL_DIR=
# 会话消息压缩阈值：messages 超过此数量时自动摘要旧消息（默认 20）
# MEMORY_MAX_MESSAGES=20
# 每次检索返回的记忆条数上限（默认 10）
# MEMORY_RECALL_LIMIT=10
# 外部记忆服务超时(秒)
# MEMORY_SERVICE_TIMEOUT_S=10

# Prepend extra directories to PATH (e.g. for uv, node, etc.)
# EXTRA_PATH=C:\Users\YourName\...\Scripts

# --- 用户配置存储 ---
# 每用户热配置 JSON 文件的根目录（默认与 MEMORY_LOCAL_DIR 同目录下的 users/ 子目录）
# USER_CONFIG_DIR=
# 单 Gateway 进程允许的最大 RuntimeService 实例数（默认 20）
# MAX_RUNTIME_INSTANCES=20
# RuntimeService 空闲超时（秒）：超过此时长无消息往来则自动销毁实例（默认 300 = 5 分钟）
# RUNTIME_IDLE_TIMEOUT_S=300
# call.hangup 后的宽限期（秒）：挂断后若宽限期内无消息则销毁实例，期间来电可复用（默认 300 = 5 分钟）
# RUNTIME_HANGUP_GRACE_S=300

# --- Gateway 监听地址 ---
# Gateway 对外 WebSocket 监听地址（默认 0.0.0.0，监听所有网卡）
# GATEWAY_HOST=0.0.0.0
# Gateway 对外 WebSocket 监听端口（默认 8765）
# GATEWAY_PORT=8765

# System prompt 语言: zh（中文，默认）/ en（英文）
# PROMPT_LANG=zh

# 日志输出到文件（默认只输出到 stderr）
# 支持相对路径和绝对路径，目录不存在会自动创建
# LOG_FILE=logs/runtime.log

